{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true
  },
  "organizeImports": {
    "enabled": false
  },
  "files": {
    "ignore": ["dist", "node_modules", ".wrangler"]
  },
  "overrides": [
    {
      "include": ["**/tsconfig*.json"],
      "json": { "parser": { "allowComments": true } }
    }
  ]
}
