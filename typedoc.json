{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "merge",
  "out": "docs/api",
  "name": "Anchorage API reference",
  "includeVersion": true,
  "readme": "docs/api-reference.md",
  "excludeExternals": true,
  "excludeInternal": true,
  "githubPages": true,
  "treatWarningsAsErrors": true,
  "externalSymbolLinkMappings": {
    "@mastra/core": {
      "Agent.resumeGenerate": "https://mastra.ai/reference/agents/agent",
      "DurableAgent.resume": "https://mastra.ai/reference/agents/durable-agent#resumerunid-resumedata-options",
      "FullOutput": "https://mastra.ai/reference/agents/durable-agent",
      "PruneResult": "https://mastra.ai/docs/storage/overview#configure-for-production"
    },
    "global": {
      "AgentScheduleWorker": "https://mastra.ai/docs/long-running-agents/schedules"
    }
  },
  "hostedBaseUrl": "https://proofoftechorg.github.io/anchorage/",
  "navigationLinks": {
    "Documentation": "https://github.com/ProofOfTechOrg/anchorage/tree/main/docs",
    "GitHub": "https://github.com/ProofOfTechOrg/anchorage"
  },
  "validation": {
    "notDocumented": true,
    "notExported": true,
    "invalidLink": true,
    "invalidPath": true
  }
}
