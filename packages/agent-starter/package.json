{
  "name": "anchorage-agent-starter",
  "version": "0.0.17",
  "private": true,
  "description": "Production-shaped Cloudflare Workers starter for durable, approval-gated Anchorage agents",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:conformance": "node scripts/build-conformance.mjs",
    "check": "pnpm run test && pnpm run typecheck",
    "check:imports": "pnpm -w run architecture:check:agent-starter",
    "conformance:config": "node scripts/emit-conformance-config.mjs",
    "conformance:verify": "node scripts/build-conformance.mjs && node scripts/conformance-verify.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "pnpm run check:imports && vitest run",
    "token": "node scripts/mint-token.mjs",
    "pretypecheck": "pnpm --filter @proofoftech/breakwater --filter @proofoftech/flowsafe build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mastra/core": "1.53.0",
    "@proofoftech/breakwater": "workspace:*",
    "@proofoftech/flowsafe": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2025",
    "typescript": "^5.6",
    "vitest": "^4.1.8",
    "wrangler": "^4.107.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0"
}
