{
  "contractVersion": 1,
  "tenantTags": ["tenanta", "tenantb"],
  "environment": "conformance",
  "dispatchNamespace": "anchorage-conformance",
  "hostRoutingKvId": "REPLACE_WITH_SCRATCH_KV_NAMESPACE_ID",
  "sharedOutboundWorkerName": "anchorage-conformance-outbound",
  "auditQueueName": "anchorage-conformance-audit",
  "maintenanceBaseUrls": {
    "tenanta": "https://control-tenanta.replace-me.example",
    "tenantb": "https://control-tenantb.replace-me.example"
  },
  "routeHostnames": {
    "tenanta": "tenanta.replace-me.example",
    "tenantb": "tenantb.replace-me.example"
  },
  "workerBundle": "../agent-starter/dist/conformance/candidate.mjs",
  "mainModule": "worker.js",
  "compatibilityDate": "2026-07-08",
  "compatibilityFlags": ["nodejs_compat"],
  "schemaVersion": 0,
  "migrations": [],
  "cpuLimitMs": 50,
  "subrequestLimit": 20,
  "durableObjectBindings": [
    {
      "name": "MAINTENANCE",
      "className": "Maintenance"
    },
    {
      "name": "RUNNER",
      "className": "ConformanceRunner"
    },
    {
      "name": "CONFORMANCE_STATE",
      "className": "ConformanceState"
    }
  ],
  "application": {
    "vars": [
      {
        "name": "APPLICATION_MODE",
        "value": "conformance"
      }
    ],
    "secrets": [],
    "r2Buckets": [
      {
        "name": "APPLICATION_FILES",
        "jurisdiction": "default"
      }
    ]
  },
  "applicationSecretBinding": "APPLICATION_CONFORMANCE_SECRET",
  "conformance": {
    "httpPath": "/.well-known/anchorage/conformance/v1/actions",
    "webSocketPath": "/.well-known/anchorage/conformance/v1/websocket",
    "allowedUpstreamUrl": "https://allowed-upstream.replace-me.example/probe",
    "deniedUpstreamUrl": "https://denied-upstream.replace-me.example/probe",
    "deniedUpstreamStatus": 403,
    "cpuOverLimitStatus": 500,
    "applicationVariableName": "APPLICATION_MODE",
    "applicationVariableValue": "conformance",
    "newDurableObjectBinding": {
      "name": "CONFORMANCE_V2",
      "className": "ConformanceV2"
    }
  },
  "platformProfile": {
    "runtimeContractVersion": 1,
    "backwardCompatibleWithRetainedReleases": true,
    "maintenanceCapabilityPublicKey": "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"alg\":\"EdDSA\",\"kid\":\"replace-with-active-kid\",\"x\":\"replace-with-43-character-base64url-public-key\"}",
    "stateProfiles": [
      {
        "name": "v1",
        "stateWorker": {
          "bundle": "../agent-starter/dist/conformance/trusted-state-v1.mjs",
          "mainModule": "state.js",
          "compatibilityDate": "2026-07-08",
          "compatibilityFlags": ["nodejs_compat"]
        },
        "stateDurableObjectMigrations": [
          {
            "tag": "v1",
            "newSqliteClasses": [
              "Maintenance",
              "ConformanceRunner",
              "ConformanceState",
              "FlowsafeFleetAuditProxy"
            ]
          }
        ]
      },
      {
        "name": "v2",
        "stateWorker": {
          "bundle": "../agent-starter/dist/conformance/trusted-state-v2.mjs",
          "mainModule": "state.js",
          "compatibilityDate": "2026-07-08",
          "compatibilityFlags": ["nodejs_compat"]
        },
        "stateDurableObjectMigrations": [
          {
            "tag": "v1",
            "newSqliteClasses": [
              "Maintenance",
              "ConformanceRunner",
              "ConformanceState",
              "FlowsafeFleetAuditProxy"
            ]
          },
          {
            "tag": "v2",
            "newSqliteClasses": ["ConformanceV2"]
          }
        ]
      }
    ],
    "organizationEgressHosts": ["allowed-upstream.replace-me.example"]
  },
  "exportDirectory": "/tmp/anchorage-conformance-exports"
}
