{
  "name": "@proofoftech/breakwater",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CONNECTORS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "description": "Safety middleware for AI agent workflows — policy engine, RBAC + audit, connector SDK",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProofOfTechOrg/anchorage.git",
    "directory": "packages/breakwater"
  },
  "homepage": "https://github.com/ProofOfTechOrg/anchorage/tree/main/packages/breakwater#readme",
  "bugs": "https://github.com/ProofOfTechOrg/anchorage/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./policy-engine": "./dist/policy-engine/index.js",
    "./rbac": "./dist/rbac/index.js",
    "./audit": "./dist/audit/index.js",
    "./connector-sdk": "./dist/connector-sdk/index.js",
    "./agent-cli": "./dist/agent-cli/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -w exec biome check packages/breakwater",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@mastra/core": "^1.50.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.50.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.6",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "keywords": [
    "mastra",
    "ai-agents",
    "security",
    "rbac",
    "policy-engine",
    "audit-log"
  ],
  "license": "Apache-2.0"
}
