{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    // tsc enforces rootDir even under noEmit; widen it to the repo root so the
    // breakwater source (resolved via the path below) is admitted, matching
    // tsconfig.test.json's cross-package approach.
    "rootDir": "../../..",
    // breakwater resolves to source (matches the vitest alias); flowsafe is
    // imported by relative ../src paths, so no mapping is needed for it.
    "paths": {
      "@proofoftech/breakwater": ["../../breakwater/src/index.ts"]
    }
  },
  "include": [
    "./worker.ts",
    "./runtime.ts",
    "./workflows/**/*.ts",
    "../src/**/*.ts"
  ],
  // approval-ui's barrel/JSX compile only in src/approval-ui/tsconfig.json (DOM
  // lib); this workers-types program must not pull them in. Tests type-check
  // under tsconfig.test.json.
  "exclude": [
    "../src/**/*.test.ts",
    "../src/approval-ui/**/*.tsx",
    "../src/approval-ui/index.ts"
  ]
}
