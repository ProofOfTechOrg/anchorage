{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    // breakwater resolves to source (matches the vitest alias) so this pass
    // never depends on a built breakwater dist — a fresh checkout typechecks
    // before any build.
    "paths": {
      "@proofoftech/breakwater": ["../../breakwater/src/index.ts"]
    }
  },
  "include": ["./worker.ts", "../src/**/*.ts"],
  // approval-ui's barrel/JSX compile only in src/approval-ui/tsconfig.json
  // (DOM lib); this workers-types program must not pull them in.
  "exclude": [
    "../src/**/*.test.ts",
    "../src/approval-ui/**/*.tsx",
    "../src/approval-ui/index.ts"
  ]
}
