{
  "name": "@proofoftech/flowsafe",
  "version": "0.7.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "description": "Approval UX + Cloudflare-native durable execution for AI agent workflows",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProofOfTechOrg/anchorage.git",
    "directory": "packages/flowsafe"
  },
  "homepage": "https://github.com/ProofOfTechOrg/anchorage/tree/main/packages/flowsafe#readme",
  "bugs": "https://github.com/ProofOfTechOrg/anchorage/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./agent-host": "./dist/agent-host/index.js",
    "./agent-runner": "./dist/agent-runner/index.js",
    "./approval-api": "./dist/approval-api/index.js",
    "./background-tasks": "./dist/background-tasks/index.js",
    "./approval-ui": "./dist/approval-ui/index.js",
    "./artifacts": "./dist/artifacts/index.js",
    "./audit-export": "./dist/audit-export/index.js",
    "./do-runner": "./dist/do-runner/index.js",
    "./goals": "./dist/goals/index.js",
    "./host-kit": "./dist/host-kit/index.js",
    "./host-kit/module": "./dist/host-kit/module.js",
    "./schedules": "./dist/schedules/index.js",
    "./signal-providers": "./dist/signal-providers/index.js",
    "./signals": "./dist/signals/index.js",
    "./signals/client": "./dist/signals/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && tsc -p src/approval-ui/tsconfig.json",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:agent-host-export": "node scripts/agent-host-pack-test.mjs",
    "test:signals-client-export": "node scripts/signals-client-pack-test.mjs",
    "test:watch": "vitest",
    "example:gtm": "vitest run examples/gtm-outbound.e2e.test.ts",
    "lint": "pnpm -w exec biome check packages/flowsafe",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p src/approval-ui/tsconfig.json --noEmit && tsc -p src/approval-ui/tsconfig.test.json && tsc -p spike/tsconfig.json && tsc -p deploy/tsconfig.json",
    "typecheck:react18": "tsc -p scripts/react18-probe/tsconfig.json",
    "spike": "wrangler dev --config spike/wrangler.jsonc",
    "spike:verify": "node scripts/spike-verify.mjs",
    "spike:verify:llm": "node scripts/spike-verify-llm.mjs",
    "deploy:cf": "wrangler deploy --config deploy/wrangler.jsonc",
    "deploy:dev": "wrangler dev --config deploy/wrangler.jsonc",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@mastra/core": "^1.50.0",
    "@proofoftech/breakwater": ">=0.6.0 <1.0.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@proofoftech/breakwater": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2025",
    "@mastra/core": "^1.50.0",
    "@proofoftech/breakwater": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.10.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "types-react-18": "npm:@types/react@^18.3.31",
    "types-react-dom-18": "npm:@types/react-dom@^18.3.7",
    "typescript": "^5.6",
    "vitest": "^4.1.8",
    "wrangler": "^4.107.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "mastra",
    "ai-agents",
    "approval-workflow",
    "human-in-the-loop",
    "cloudflare-workers",
    "durable-objects"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@mastra/cloudflare-d1": "^1.1.1"
  }
}
