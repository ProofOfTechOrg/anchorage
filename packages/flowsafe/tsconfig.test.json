{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Type-resolve breakwater from source (matches the vitest alias). tsc
    // enforces rootDir even under noEmit, so widen it to the repo root to
    // admit ../breakwater/src into this (emit-free) program.
    "rootDir": "../..",
    "paths": {
      "@proofoftech/breakwater": ["../breakwater/src/index.ts"],
      // deploy/worker.ts (pulled in by its e2e test) imports the package
      // specifiers a copy-ready consumer would; resolve them to source here
      // (matches the vitest aliases).
      "@proofoftech/flowsafe/approval-api": ["./src/approval-api/index.ts"],
      "@proofoftech/flowsafe/audit-export": ["./src/audit-export/index.ts"],
      "@proofoftech/flowsafe/do-runner": ["./src/do-runner/index.ts"],
      "@proofoftech/flowsafe/host-kit": ["./src/host-kit/index.ts"]
    }
  },
  "include": [
    "src",
    "examples",
    "deploy/worker.ts",
    "deploy/worker.e2e.test.ts",
    "showcase/**/*.test.ts",
    "showcase/runtime.ts",
    "showcase/workflows/**/*.ts"
  ],
  "exclude": ["src/approval-ui/**/*.tsx", "src/approval-ui/index.ts"]
}
