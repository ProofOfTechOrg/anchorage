{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Type-resolve breakwater from source (matches the vitest alias). tsc
    // enforces rootDir even under noEmit, so widen it to the repo root to
    // admit ../breakwater/src into this (emit-free) program.
    "rootDir": "../..",
    "paths": {
      "@proofoftech/breakwater": ["../breakwater/src/index.ts"],
      "@proofoftech/breakwater/agent": ["../breakwater/src/agent/index.ts"],
      "@proofoftech/breakwater/audit": ["../breakwater/src/audit/index.ts"],
      "@proofoftech/breakwater/connector-sdk": [
        "../breakwater/src/connector-sdk/index.ts"
      ],
      "@proofoftech/breakwater/rbac": ["../breakwater/src/rbac/index.ts"],
      // deploy/worker.ts (pulled in by its e2e test) imports the package
      // specifiers a copy-ready consumer would; resolve them to source here
      // (matches the vitest aliases).
      "@proofoftech/flowsafe/approval-api": ["./src/approval-api/index.ts"],
      "@proofoftech/flowsafe/agent-host": ["./src/agent-host/index.ts"],
      "@proofoftech/flowsafe/audit-export": ["./src/audit-export/index.ts"],
      "@proofoftech/flowsafe/do-runner": ["./src/do-runner/index.ts"],
      "@proofoftech/flowsafe/host-kit": ["./src/host-kit/index.ts"]
    }
  },
  "include": [
    "src",
    "examples",
    "deploy/worker.ts",
    "deploy/worker.e2e.test.ts"
  ],
  "exclude": [
    "src/approval-ui/**/*.tsx",
    "src/approval-ui/index.ts",
    // Imports the .tsx contract, which this workers-typed (jsx-free) program
    // cannot compile; the approval-ui UI test pass typechecks it instead.
    "src/approval-ui/components.test.ts",
    // Imports FilterBar.tsx — same JSX-import exclusion as components.test.ts.
    "src/approval-ui/filter-bar.test.ts",
    // Imports react-dom/client, which needs DOM types this workers-typed
    // program lacks; the approval-ui UI test pass typechecks it instead.
    "src/approval-ui/use-approval-dashboard.render.test.ts"
  ]
}
