{
  // Browser app pass: DOM lib + JSX + Vite client types. tsc only type-checks
  // (Vite bundles). The Node-side vite.config.ts + approval-api-dev-plugin.ts
  // are type-checked by tsconfig.node.json, so they stay out of this `include`.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src"]
}
