{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "flowsafe-do-runner-demo",
  "main": "./worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep every import of the guarded-agent brand on one module instance. The
  // spike typechecks against Breakwater source before package builds exist,
  // while package subpath imports otherwise resolve to dist during bundling.
  "alias": {
    "@proofoftech/breakwater/agent": "../../breakwater/src/agent/index.ts"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER", "class_name": "DemoRunner" },
      { "name": "HUB", "class_name": "DemoHub" },
      { "name": "THREAD", "class_name": "DemoThread" },
      { "name": "BACKGROUND_TASKS", "class_name": "DemoBackgroundTasks" },
      {
        "name": "SIGNAL_PROVIDER_HOST",
        "class_name": "DemoSignalProviderHost"
      }
    ]
  },
  // Append-only DO migrations: the v1 runner + v2 hub + v3 thread tags are
  // frozen; the Track E deployment provider host DO ships under its own v4 tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DemoRunner"] },
    { "tag": "v2", "new_sqlite_classes": ["DemoHub"] },
    { "tag": "v3", "new_sqlite_classes": ["DemoThread"] },
    { "tag": "v4", "new_sqlite_classes": ["DemoSignalProviderHost"] },
    { "tag": "v5", "new_sqlite_classes": ["DemoBackgroundTasks"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flowsafe-demo",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // LOCAL-ONLY spike fixture (this worker is never deployed): signs the ~60s
  // WebSocket stream tickets so the /api/stream/* stage MOUNTS under
  // `pnpm spike`. scripts/spike-verify.mjs re-passes the SAME value via
  // `--var STREAM_TICKET_SECRET:...` so its forged-ticket probes share the key;
  // keep the two byte-equal (like SWEEP_CRON/PURGE_CRON). Never a real secret.
  "vars": {
    "DEPLOYMENT_TENANT": "spike",
    "DEPLOYMENT_IDENTITY_SECRET": "spike-local-deployment-identity-secret",
    "STREAM_TICKET_SECRET": "spike-local-stream-secret-do-not-deploy",
    // Track E: the github webhook signing secret. spike-verify.mjs re-passes it
    // via `--var` and signs its webhook probes with it (byte-equal). Never a real
    // secret; this worker is never deployed.
    "GITHUB_WEBHOOK_SECRET": "spike-local-github-secret-do-not-deploy"
  }
}
