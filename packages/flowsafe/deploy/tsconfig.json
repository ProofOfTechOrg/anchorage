{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    // Copy-ready package specifiers resolve to source here; consumers keep
    // the same imports against the published package. breakwater too (matches
    // the vitest alias) so this pass never depends on a built breakwater dist.
    "paths": {
      "@proofoftech/breakwater": ["../../breakwater/src/index.ts"],
      "@proofoftech/breakwater/*": ["../../breakwater/src/*/index.ts"],
      "@proofoftech/flowsafe/approval-api": ["../src/approval-api/index.ts"],
      "@proofoftech/flowsafe/audit-export": ["../src/audit-export/index.ts"],
      "@proofoftech/flowsafe/do-runner": ["../src/do-runner/index.ts"],
      "@proofoftech/flowsafe/host-kit": ["../src/host-kit/index.ts"]
    }
  },
  "include": [
    "./worker.ts",
    "../src/**/*.ts",
    "../test-support/maintenance-alarm-harness-worker.ts"
  ],
  // approval-ui's barrel/JSX compile only in src/approval-ui/tsconfig.json
  // (DOM lib); this workers-types program must not pull them in.
  "exclude": [
    "../src/**/*.test.ts",
    "../src/approval-ui/**/*.tsx",
    "../src/approval-ui/index.ts"
  ]
}
