{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "anchorage-flowsafe",
  "main": "./worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // The worker emits structured JSON (audit + maintenance) to Workers Logs.
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER", "class_name": "FlowsafeRunner" },
      // Per-tenant live-stream fan-out hub (one instance per tenant,
      // idFromName(tenantId)). Streaming activates only once the
      // STREAM_TICKET_SECRET secret is also set (opt-in).
      { "name": "HUB", "class_name": "FlowsafeHub" }
    ]
  },
  // DO migrations are APPEND-ONLY: the v1 runner tag is frozen; the hub class
  // ships under its own new v2 tag. Never edit v1 or reuse a tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FlowsafeRunner"] },
    { "tag": "v2", "new_sqlite_classes": ["FlowsafeHub"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anchorage-flowsafe",
      // `wrangler d1 create anchorage-flowsafe` prints the id — paste it here.
      // Tables are created lazily by the stores; no migration files needed.
      "database_id": "REPLACE-WITH-YOUR-D1-DATABASE-ID"
    }
  ],
  // TWO cron expressions, dispatched on controller.cron (worker.ts
  // scheduled()): the SLA sweep and the retention purge never share an
  // invocation — a CPU-limit termination is not catchable, so a slow sweep
  // sharing one would permanently starve the purge. Keep these equal to
  // crons.ts's SWEEP_CRON / PURGE_CRON; keep the sweep interval >= your SLA
  // granularity.
  "triggers": { "crons": ["*/15 * * * *", "7 * * * *"] },
  // Optional audit export to a SIEM: `wrangler queues create anchorage-audit`
  // (and anchorage-audit-dlq), uncomment, then set SIEM_ENDPOINT (var below)
  // and SIEM_AUTH_HEADER (secret). Without this block, audit events stay on
  // structured Workers Logs only.
  // "queues": {
  //   "producers": [{ "binding": "AUDIT_QUEUE", "queue": "anchorage-audit" }],
  //   "consumers": [
  //     {
  //       "queue": "anchorage-audit",
  //       "max_retries": 10,
  //       "dead_letter_queue": "anchorage-audit-dlq"
  //     }
  //   ]
  // },
  "vars": {
    "APPROVAL_SLA_SECONDS": "14400",
    "RUN_RETENTION_DAYS": "30",
    "APPROVAL_RETENTION_DAYS": "30"
    // Separation of duties is ON by default (the requester cannot decide their
    // own request). A single-operator deployment can exempt one role so it can
    // self-approve; any invalid value falls back to OFF. Leave unset to keep
    // SoD fully on.
    // "APPROVAL_ALLOW_SELF_DECISION": "admin"
    // Client-per-subdomain deployments: set the apex and every request to
    // <tenant>.<apex> is denied unless the token's VERIFIED tenant is that
    // tenant. Defense in depth over the tenant-bound stores (INV-2) — it
    // closes the confused-deputy UX where a user pastes tenant A's token into
    // tenant B's branded host. Hosts outside the apex and the reserved
    // never-allocatable subdomains (app/www/api/docs/admin/status, plus
    // system/default) skip the check.
    // "TENANT_APEX_DOMAIN": "example.com"
    // "SIEM_ENDPOINT": "https://siem.example/services/collector"
  }
  // Secrets (set with `wrangler secret put <name>`):
  //   APPROVAL_ACTOR_TOKENS — JSON map of bearer token ->
  //     { id, role, tenantId }; roles: admin | builder | operator | reviewer |
  //     viewer; tenantId must match ^[a-z0-9]{3,32}$ (INV-3) and must not be
  //     'system' (the maintenance actor's audit identity) or the entry is
  //     dropped and its token 401s. Provision each tenantId through the
  //     `tenants` registry (provisionTenant) BEFORE issuing its tokens
  //     (single-tenant hosts: see README "Hosting a single tenant").
  //   SIEM_AUTH_HEADER — sent as the `authorization` header on audit export,
  //     e.g. "Splunk <hec-token>".
  //   STREAM_TICKET_SECRET — OPTIONAL; enables live streaming. A DEDICATED HMAC
  //     key that signs the ~60s WebSocket stream tickets (DL-010). Keep it
  //     distinct from any session-JWT secret. Absent => the /api/stream/* stage
  //     stays unmounted and dashboards poll (streaming is opt-in). The HUB DO
  //     binding above is always declared; the secret is the on/off switch.
}
