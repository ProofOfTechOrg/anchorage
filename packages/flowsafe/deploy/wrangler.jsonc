{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Replace `replace-me` with the deployment tag before creating any resource.
  // The Worker name is the Durable Object namespace boundary, so every
  // organization must use a distinct script name.
  "name": "anchorage-flowsafe-replace-me",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["DEPLOYMENT_IDENTITY_SECRET"]
  },
  // The worker emits structured JSON (audit + maintenance) to Workers Logs.
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER", "class_name": "FlowsafeRunner" },
      // Deployment live-stream fan-out singleton. Streaming activates once the
      // STREAM_TICKET_SECRET secret is also set (opt-in).
      { "name": "HUB", "class_name": "FlowsafeHub" }
    ]
  },
  // DO migrations are APPEND-ONLY: the v1 runner tag is frozen; the hub class
  // ships under its own new v2 tag. Never edit v1 or reuse a tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FlowsafeRunner"] },
    { "tag": "v2", "new_sqlite_classes": ["FlowsafeHub"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anchorage-flowsafe-replace-me",
      // `wrangler d1 create anchorage-flowsafe-<tag>` prints the id — paste it here.
      // Provisioning must seed flowsafe_deployment before serving.
      "database_id": "REPLACE-WITH-YOUR-D1-DATABASE-ID"
    }
  ],
  // TWO cron expressions, dispatched on controller.cron (worker.ts
  // scheduled()): the SLA sweep and the retention purge never share an
  // invocation — a CPU-limit termination is not catchable, so a slow sweep
  // sharing one would permanently starve the purge. Keep these equal to
  // crons.ts's SWEEP_CRON / PURGE_CRON; keep the sweep interval >= your SLA
  // granularity.
  "triggers": { "crons": ["*/15 * * * *", "7 * * * *"] },
  // Optional audit export to a SIEM. Replace `replace-me` with the deployment
  // tag, create both queues, uncomment this block, then set SIEM_ENDPOINT (var
  // below) and SIEM_AUTH_HEADER (secret). Without this block, audit events stay
  // on structured Workers Logs only.
  //   wrangler queues create anchorage-flowsafe-replace-me-audit
  //   wrangler queues create anchorage-flowsafe-replace-me-audit-dlq
  // "queues": {
  //   "producers": [
  //     {
  //       "binding": "AUDIT_QUEUE",
  //       "queue": "anchorage-flowsafe-replace-me-audit"
  //     }
  //   ],
  //   "consumers": [
  //     {
  //       "queue": "anchorage-flowsafe-replace-me-audit",
  //       "max_retries": 10,
  //       "dead_letter_queue": "anchorage-flowsafe-replace-me-audit-dlq"
  //     }
  //   ]
  // },
  "vars": {
    // Must match the flowsafe_deployment sentinel in this deployment's DB.
    // Deliberately invalid until provisioning replaces it with a lowercase tag.
    "DEPLOYMENT_TENANT": "REPLACE_WITH_DEPLOYMENT_TAG",
    "APPROVAL_SLA_SECONDS": "14400",
    "RUN_RETENTION_DAYS": "30",
    "APPROVAL_RETENTION_DAYS": "30"
    // Separation of duties is ON by default (the requester cannot decide their
    // own request). A single-operator deployment can exempt one role so it can
    // self-approve; any invalid value falls back to OFF. Leave unset to keep
    // SoD fully on.
    // "APPROVAL_ALLOW_SELF_DECISION": "admin"
    // "SIEM_ENDPOINT": "https://siem.example/services/collector"
  }
  // Secrets (set with `wrangler secret put <name>`):
  //   DEPLOYMENT_IDENTITY_SECRET — REQUIRED; at least 32 random visible ASCII characters.
  //     Shared only by this deployment's Worker and Durable Objects.
  //   APPROVAL_ACTOR_TOKENS — JSON map of bearer token ->
  //     { id, role }; roles: admin | builder | operator | reviewer | viewer.
  //     Unknown roles or malformed actor ids are dropped and their tokens 401.
  //   SIEM_AUTH_HEADER — sent as the `authorization` header on audit export,
  //     e.g. "Splunk <hec-token>".
  //   STREAM_TICKET_SECRET — OPTIONAL; enables live streaming. A DEDICATED HMAC
  //     key that signs the ~60s WebSocket stream tickets (DL-010). Keep it
  //     distinct from any session-JWT secret. Absent => the /api/stream/* stage
  //     stays unmounted and dashboards poll (streaming is opt-in). The HUB DO
  //     binding above is always declared; the secret is the on/off switch.
}
