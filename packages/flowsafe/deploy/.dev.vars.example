# Local-dev secrets for `pnpm deploy:dev` (wrangler picks up `.dev.vars`).
#   cp .dev.vars.example .dev.vars
# These sample tokens are for local workerd only — mint real random tokens
# for production via `wrangler secret put APPROVAL_ACTOR_TOKENS`.
APPROVAL_ACTOR_TOKENS={"dev-operator":{"id":"op","role":"operator"},"dev-reviewer":{"id":"ray","role":"reviewer"},"dev-viewer":{"id":"vic","role":"viewer"}}
DEPLOYMENT_IDENTITY_SECRET=local-only-deployment-identity-secret
