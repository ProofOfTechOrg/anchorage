{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "anchorage-showcase",
  "main": "./worker/worker.ts",
  // esbuild bundles the worker with these paths, so flowsafe + breakwater
  // bundle from SOURCE — wrangler dev/deploy need no prior dist build.
  "tsconfig": "./tsconfig.worker.json",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // The account hosting the proofoftech.org zone (the custom domain below
  // must live on the same account). Pinned because the deploying identity
  // has access to more than one account.
  "account_id": "056cbaa6f5c3d8ff5584f1aa84bbe050",
  // The ONLY public origin. The OAuth callback is registered for exactly this
  // origin (the worker derives redirect_uri from url.origin), so a second
  // reachable host would half-work: API yes, sign-in no. workers_dev off
  // keeps the origin single — and the SPA carries a TEMPORARY noindex robots
  // meta (index.html) until the demo should be indexable. Prerequisite:
  // proofoftech.org must be a zone on this Cloudflare account.
  "workers_dev": false,
  "routes": [{ "pattern": "anchorage.proofoftech.org", "custom_domain": true }],
  // The worker emits structured JSON (audit + maintenance + connector previews)
  // to Workers Logs.
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "RUNNER", "class_name": "ShowcaseRunner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShowcaseRunner"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anchorage-showcase",
      // Local `wrangler dev` creates a local SQLite automatically. Tables are
      // created lazily by the stores; no migration files needed. This id is
      // the live anchorage.proofoftech.org database (`wrangler d1 create
      // anchorage-showcase` on the account above).
      "database_id": "342fd280-2b62-4ae3-90ea-afb5133a8823"
    }
  ],
  // Single-deploy: serve the built SPA (dist/) at / via Workers Static
  // Assets, and the API on the SAME origin. run_worker_first is load-bearing —
  // without it the SPA fallback would swallow the API routes (they are not files
  // on disk). Everything else (/, deep SPA routes) serves index.html. Build the
  // SPA first (`pnpm --filter showcase build`) so ./dist exists.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/runs",
      "/runs/*",
      "/healthz",
      "/workflows",
      "/auth/*",
      "/demo/*"
    ]
  },
  // The public demo runs REAL isolate CPU per visitor run. Cap it (Workers
  // PAID feature — the demo needs the paid plan anyway for sane limits) and
  // set a billing alert in the dashboard: the caps below REACT to load; the
  // alert is what tells you they are reacting.
  "limits": { "cpu_ms": 30000 },
  // The showcase runs OFFLINE by default: no `send_email` binding => the
  // gtm-outbound connector simulates the send (logs the envelope, zero secrets),
  // and the CRM/deploy egress connectors simulate too (they are wired from
  // defineWorkflows() in worker.ts, unset here). content-pipeline's R2 write is
  // offline-real via the in-memory artifact bucket. To send real email: onboard
  // a domain (`wrangler email sending enable <yourdomain>`), then uncomment.
  // Cloudflare Email Service is TRANSACTIONAL — for bulk campaigns swap the
  // connector's execute for a marketing ESP.
  // "send_email": [{ "name": "EMAIL" }],
  // TWO cron expressions, dispatched on controller.cron (worker.ts
  // SWEEP_CRON / PURGE_CRON — keep these literals in sync): the SLA sweep and
  // the purge never share an invocation, because a CPU-limit termination
  // kills the isolate un-catchably and a slow sweep would otherwise starve
  // the purge forever.
  "triggers": { "crons": ["*/15 * * * *", "7 * * * *"] },
  // Optional audit export to a SIEM: `wrangler queues create showcase-audit`
  // (and -dlq), uncomment, then set SIEM_ENDPOINT (var) + SIEM_AUTH_HEADER
  // (secret). Without this block, audit stays on structured Workers Logs only.
  // "queues": {
  //   "producers": [{ "binding": "AUDIT_QUEUE", "queue": "showcase-audit" }],
  //   "consumers": [
  //     {
  //       "queue": "showcase-audit",
  //       "max_retries": 10,
  //       "dead_letter_queue": "showcase-audit-dlq"
  //     }
  //   ]
  // },
  "vars": {
    "APPROVAL_SLA_SECONDS": "14400",
    "RUN_RETENTION_DAYS": "30",
    // Separation of duties: relax it for `admin` only, so a single operator can
    // drive product-launch's two gates alone (gate 2 would otherwise 403 the
    // gate-1 decider). Reviewer stays SoD-bound, so the demo still shows a live
    // 403. Unset/`false` keeps SoD fully on; a CSV widens it (e.g. `admin,reviewer`).
    "APPROVAL_ALLOW_SELF_DECISION": "admin",
    "OUTREACH_FROM_ADDRESS": "gtm@example.com",
    "OUTREACH_FROM_NAME": "Anchorage Showcase",
    // Public-demo tuning (ops-tunable without a code change). The DAILY cap
    // is the spend backstop — per-identity limits are a speed bump against N
    // free accounts, so size this for tolerable spend, not expected traffic.
    "DEMO_TENANT_RUN_CAP": "20",
    "DEMO_DAILY_RUN_CAP": "500",
    "DEMO_TENANT_TTL_HOURS": "24",
    "DEMO_JWT_TTL_SECONDS": "3600",
    // The launch OAuth provider is GOOGLE (worker.ts prefers it when both
    // are configured; GitHub remains a config-only fallback). The Google
    // OAuth client's authorized redirect URI must be EXACTLY
    // https://anchorage.proofoftech.org/auth/google/callback, and its consent
    // screen must be "In production" (Testing status only admits listed test
    // users — no verification review needed for the bare `openid` scope).
    "GOOGLE_CLIENT_ID": "540939373490-5jfq332en4l4q5cc70fjth76l9v65oqm.apps.googleusercontent.com"
    // "GITHUB_CLIENT_ID": "<your GitHub OAuth app client id>",
    // "DEMO_DISABLED": "true",   // kill switch: 503s /auth/* AND stops
    //                            // verifying already-issued demo JWTs
    // "SIEM_ENDPOINT": "https://siem.example/services/collector"
  }
  // Secrets (set with `wrangler secret put <name>`):
  //   APPROVAL_ACTOR_TOKENS — operator/admin bearer map. Deliberately NOT a
  //     var here: no credentials are baked into a deployable config, so a
  //     deploy without secrets 401s everywhere (fail closed). Local dev reads
  //     `.dev.vars` beside this file (`cp .dev.vars.example .dev.vars` first).
  //     Never seed the repo's demo tokens as the real secret — they are
  //     world-known, and one of them is `admin`.
  //   DEMO_JWT_SECRET — turns the public OAuth demo ON: signs the per-visitor
  //     HS256 token sets and the OAuth state. Generate long + random.
  //   GOOGLE_CLIENT_SECRET — pairs with the GOOGLE_CLIENT_ID var.
  //   GITHUB_CLIENT_SECRET — pairs with the GITHUB_CLIENT_ID var (fallback).
  //   SIEM_AUTH_HEADER — sent as the `authorization` header on audit export.
}
