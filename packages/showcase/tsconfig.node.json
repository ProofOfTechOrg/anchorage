{
  // Node-side pass for the Vite configuration. Worker source is checked by
  // tsconfig.worker.json; the Cloudflare plugin reads that project and the real
  // wrangler.jsonc rather than loading Worker internals into the Node process.
  "extends": ["../../tsconfig.base.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": ["vite.config.ts"]
}
