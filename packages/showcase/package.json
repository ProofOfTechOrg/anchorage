{
  "name": "showcase",
  "version": "0.0.6",
  "private": true,
  "description": "Anchorage showcase — six runnable workflows and seven guardrail scenarios behind one React frontend",
  "type": "module",
  "imports": {
    "#worker/*": "./worker/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProofOfTechOrg/anchorage.git",
    "directory": "packages/showcase"
  },
  "scripts": {
    "predev": "pnpm --filter @proofoftech/breakwater --filter @proofoftech/flowsafe build",
    "dev": "vite",
    "build": "vite build && node scripts/assert-clean-app-bundle.mjs && node scripts/assert-public-metadata.mjs",
    "preview": "vite preview",
    "dev:worker": "wrangler dev",
    "deploy:cf": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm --filter @proofoftech/breakwater --filter @proofoftech/flowsafe build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "pnpm -w exec biome check packages/showcase",
    "react-doctor": "node scripts/run-react-doctor.mjs full",
    "react-doctor:diff": "node scripts/run-react-doctor.mjs changed \"$(sh scripts/resolve-react-doctor-diff-base.sh)\""
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.3",
    "@astryxdesign/theme-y2k": "0.1.3",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/poppins": "5.2.7",
    "@mastra/core": "^1.50.0",
    "@proofoftech/breakwater": "workspace:*",
    "@proofoftech/flowsafe": "workspace:*",
    "@stylexjs/stylex": "0.18.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2025",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^25.0.0",
    "typescript": "^5.6",
    "vite": "^6",
    "vitest": "^4.1.8",
    "wrangler": "^4.107.0"
  },
  "license": "Apache-2.0"
}
