{
  "contractVersion": 1,
  "tenantTags": ["tenanta", "tenantb"],
  "environment": "conformance",
  "dispatchNamespace": "anchorage-conformance",
  "hostRoutingKvId": "replace-with-scratch-kv-namespace-id",
  "sharedOutboundWorkerName": "anchorage-conformance-outbound",
  "auditQueueName": "anchorage-conformance-audit",
  "maintenanceBaseUrls": {
    "tenanta": "https://control-a.example.test",
    "tenantb": "https://control-b.example.test"
  },
  "routeHostnames": {
    "tenanta": "tenanta.example.test",
    "tenantb": "tenantb.example.test"
  },
  "workerBundle": "./artifacts/external-candidate.mjs",
  "mainModule": "worker.js",
  "compatibilityDate": "2026-08-11",
  "schemaVersion": 0,
  "migrations": [],
  "cpuLimitMs": 50,
  "subrequestLimit": 20,
  "durableObjectBindings": [
    {
      "name": "MAINTENANCE",
      "className": "Maintenance"
    }
  ],
  "application": {
    "vars": [{ "name": "APPLICATION_MODE", "value": "conformance" }],
    "secrets": [],
    "r2Buckets": [{ "name": "APPLICATION_FILES", "jurisdiction": "default" }]
  },
  "applicationSecretBinding": "APPLICATION_CONFORMANCE_SECRET",
  "conformance": {
    "httpPath": "/.well-known/anchorage/conformance/v1/actions",
    "webSocketPath": "/.well-known/anchorage/conformance/v1/websocket",
    "allowedUpstreamUrl": "https://allowed-upstream.example.test/probe",
    "deniedUpstreamUrl": "https://denied-upstream.example.test/probe",
    "deniedUpstreamStatus": 403,
    "cpuOverLimitStatus": 500,
    "applicationVariableName": "APPLICATION_MODE",
    "applicationVariableValue": "conformance",
    "newDurableObjectBinding": {
      "name": "CONFORMANCE_V2",
      "className": "ConformanceV2"
    }
  },
  "platformProfile": {
    "runtimeContractVersion": 1,
    "backwardCompatibleWithRetainedReleases": true,
    "maintenanceCapabilityPublicKey": "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"alg\":\"EdDSA\",\"kid\":\"replace-with-active-kid\",\"x\":\"replace-with-43-character-base64url-public-key\"}",
    "stateProfiles": [
      {
        "name": "v1",
        "stateWorker": {
          "bundle": "./artifacts/trusted-state-v1.mjs",
          "mainModule": "state.js",
          "compatibilityDate": "2026-08-11"
        },
        "stateDurableObjectMigrations": [
          {
            "tag": "v1",
            "newSqliteClasses": ["Maintenance", "FlowsafeFleetAuditProxy"]
          }
        ]
      },
      {
        "name": "v2",
        "stateWorker": {
          "bundle": "./artifacts/trusted-state-v2.mjs",
          "mainModule": "state.js",
          "compatibilityDate": "2026-08-11"
        },
        "stateDurableObjectMigrations": [
          {
            "tag": "v1",
            "newSqliteClasses": ["Maintenance", "FlowsafeFleetAuditProxy"]
          },
          {
            "tag": "v2",
            "newSqliteClasses": ["ConformanceV2"]
          }
        ]
      }
    ],
    "organizationEgressHosts": ["allowed-upstream.example.test"]
  },
  "exportDirectory": "/tmp/anchorage-conformance-exports"
}
